import { LineEdit } from "std-widgets.slint";

export global ReaderColors {
    in property <bool> dark;
    out property <color> background: dark ? #181a1e : #e4eaf0;
    out property <color> header: dark ? #22252a : #eef3f7;
    out property <color> surface: dark ? #292d33 : #fcfdff;
    out property <color> raised: dark ? #373d46 : #e1eaf3;
    out property <color> border: dark ? #474f5a : #c8d3de;
    out property <color> ink: dark ? #edf4fa : #202d3a;
    out property <color> muted: dark ? #b5c5d5 : #4e6276;
    out property <color> accent: dark ? #31699a : #245782;
    out property <color> accent-ink: #ffffff;
    out property <color> selected: dark ? #304d69 : #dceaf7;
    out property <color> focus: dark ? #8fc6fa : #1f6aaa;
    out property <color> page-pending: dark ? #41464f : #dfe6ed;
    out property <color> button: dark ? #30353d : #f5f8fb;
    out property <color> button-pressed: dark ? #233c54 : #cadcf0;
    out property <color> button-pressed-border: dark ? #6c94b8 : #5481aa;
    out property <color> accent-hover: dark ? #397bb2 : #2c6597;
    out property <color> accent-pressed: dark ? #27577f : #1b4264;
}

export component ToolButton inherits Rectangle {
    in property <string> label;
    in property <string> name: label;
    in property <bool> selected;
    in property <bool> primary;
    in property <bool> quiet;
    in property <bool> square;
    in property <bool> usable: true;
    in property <length> control-height: 36px;
    in property <TextHorizontalAlignment> text-align: center;
    callback activated();
    property <bool> space-held;
    property <bool> pressed: root.usable && (touch.pressed || root.space-held);

    min-width: min(root.control-height, 40px);
    preferred-width: root.square ? root.control-height : caption.preferred-width + 20px;
    min-height: min(root.control-height, 36px);
    preferred-height: root.control-height;
    horizontal-stretch: 0;
    border-radius: min(10px, self.height / 4);
    border-width: 1px;
    border-color: keyboard.has-focus && root.usable ? ReaderColors.focus
        : root.pressed && !root.primary ? ReaderColors.button-pressed-border
        : (root.primary || (root.quiet && !root.selected)) ? transparent
        : !root.usable ? ReaderColors.border.transparentize(0.5) : ReaderColors.border;
    background: !root.usable ? transparent
        : root.primary ? (root.pressed ? ReaderColors.accent-pressed : touch.has-hover ? ReaderColors.accent-hover : ReaderColors.accent)
        : root.pressed ? ReaderColors.button-pressed
        : touch.has-hover ? ReaderColors.raised
        : root.selected ? ReaderColors.selected
        : root.quiet ? transparent : ReaderColors.button;

    accessible-role: button;
    accessible-label: root.name;
    accessible-enabled: root.usable;
    accessible-action-default => { if (root.usable) { root.activated(); } }
    changed usable => { if (!root.usable) { root.space-held = false; } }

    caption := Text {
        x: 8px;
        y: root.pressed ? 1px : 0px;
        width: parent.width - 16px;
        height: parent.height;
        text: root.label;
        color: !root.usable ? ReaderColors.muted.transparentize(0.27) : root.primary ? ReaderColors.accent-ink : ReaderColors.ink;
        font-size: 13px;
        font-weight: root.selected || root.primary ? 650 : 500;
        vertical-alignment: center;
        horizontal-alignment: root.text-align;
        overflow: elide;
        accessible-role: none;
    }

    keyboard := FocusScope {
        enabled: root.usable;
        changed has-focus => { if (!self.has-focus) { root.space-held = false; } }
        key-pressed(event) => {
            if (event.modifiers.control || event.modifiers.alt || event.modifiers.shift || event.modifiers.meta) {
                return reject;
            }
            if (event.text == " ") {
                if (!event.repeat) { root.space-held = true; }
                return accept;
            }
            if (event.text == Key.Return) {
                if (!event.repeat) { root.activated(); }
                return accept;
            }
            return reject;
        }
        key-released(event) => {
            if (event.text == " " && root.space-held) {
                root.space-held = false;
                if (root.usable) { root.activated(); }
                return accept;
            }
            return reject;
        }
    }

    touch := TouchArea {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        enabled: root.usable;
        mouse-cursor: pointer;
        clicked => {
            keyboard.focus();
            root.activated();
        }
    }
}

export component Entry inherits LineEdit {
    in property <string> name;
    preferred-height: 34px;
    font-size: 13px;
    accessible-label: name;
}

export component ToolbarDivider inherits Rectangle {
    width: 1px;
    height: 21px;
    background: ReaderColors.border;
}

export component FileMark inherits Rectangle {
    background: ReaderColors.selected;
    border-radius: 8px;

    Rectangle {
        width: parent.width * 0.43;
        height: parent.height * 0.56;
        border-color: ReaderColors.accent;
        border-width: 1.4px;
        border-radius: 2px;
        Rectangle { width: parent.width * 0.43; height: 1px; y: parent.height * 0.45; background: ReaderColors.accent; }
        Rectangle { width: parent.width * 0.43; height: 1px; y: parent.height * 0.65; background: ReaderColors.accent; }
    }
}
