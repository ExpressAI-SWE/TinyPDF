1 ICON "assets/tinypdf.ico"

1 VERSIONINFO
FILEVERSION TINYPDF_VERSION_NUMBERS
PRODUCTVERSION TINYPDF_VERSION_NUMBERS
FILEFLAGSMASK 0x3fL
FILEOS 0x40004L
FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "ExpressAI-SWE"
            VALUE "FileDescription", "TinyPDF PDF Reader"
            VALUE "FileVersion", TINYPDF_VERSION_TEXT
            VALUE "InternalName", "TinyPDF"
            VALUE "OriginalFilename", "tinypdf.exe"
            VALUE "ProductName", "TinyPDF"
            VALUE "ProductVersion", TINYPDF_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
